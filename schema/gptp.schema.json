{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/Yuxi-Labs/gptp/refs/tags/v1.1.0/schema/gptp.schema.json",
  "title": "GPT Prompt Package (.gptp) v1.1.0",
  "type": "object",
  "required": ["name", "description", "version", "messages"],

  "properties": {
    "$schema": {
      "type": "string",
      "readOnly": true,
      "description": "Location of the schema that is being used"
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$",
      "description": "Prompt semver (e.g. 1.1.0)"
    },
    "system": { "type": "string", "minLength": 1 },

    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "additionalProperties": false,
        "properties": {
          "role": { "type": "string", "enum": ["system", "user", "assistant"] },
          "content": { "type": "string", "minLength": 1 }
        }
      }
    },

    "variables": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["string", "number", "integer", "boolean", "array", "object"]
          },
          "description": { "type": "string" },
          "example": {},
          "enum": {
            "type": "array",
            "items": { "type": ["string", "number", "boolean"] }
          },
          "pattern": { "type": "string" },
          "minLength": { "type": "integer", "minimum": 0 },
          "maxLength": { "type": "integer", "minimum": 0 },
          "minimum": { "type": "number" },
          "maximum": { "type": "number" },
          "default": {}
        },
        "additionalProperties": true
      }
    },

    "metadata": {
      "type": "object",
      "description": "Informational metadata (e.g. tags, creation info)",
      "additionalProperties": true,
      "properties": {
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "created_by": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "model_compatibility": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },

    "rendering": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "style": {
          "type": "string",
          "enum": ["chat", "single-shot", "template"]
        },
        "instructions_position": {
          "type": "string",
          "enum": ["top", "inline", "none"]
        }
      }
    },

    "output_format": {
      "type": "string",
      "enum": ["markdown", "json", "plain-text", "html"]
    },

    "output_schema": {
      "type": "object",
      "description": "JSON Schema contract for model output when output_format=json"
    },

    "params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string" },
        "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
        "top_p": { "type": "number", "minimum": 0, "maximum": 1 },
        "max_tokens": { "type": "integer", "minimum": 1 },
        "stop": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            }
          ]
        },
        "seed": { "type": "integer" },
        "frequency_penalty": { "type": "number", "minimum": -2, "maximum": 2 },
        "presence_penalty": { "type": "number", "minimum": -2, "maximum": 2 }
      }
    },

    "connections": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "active": { "type": "string" },
        "providers": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": { "type": "string" },
              "endpoint": { "type": "string" },
              "deployment": { "type": "string" },
              "api_key": { "type": "string" }
            }
          }
        }
      }
    },

    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "media_type": { "type": "string" },
          "purpose": {
            "type": "string",
            "enum": ["context", "example", "citation", "other"]
          },
          "description": { "type": "string" }
        }
      }
    },

    "license": {
      "type": "string",
      "description": "SPDX identifier, e.g. MIT, Apache-2.0"
    },

    "usage_notes": { "type": "string" },

    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "signature": { "type": "string" }
      }
    },

    "secrets": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Environment variable names required at runtime"
    },

    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "parameters_schema": { "type": "object" }
        }
      }
    },

    "vision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow_images": { "type": "boolean" },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "media_type"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "media_type": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        }
      }
    },

    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["input"],
        "additionalProperties": true,
        "properties": {
          "name": { "type": "string" },
          "input": { "type": "object" },
          "expect_contains": {
            "type": "array",
            "items": { "type": "string" }
          },
          "expect_exact": { "type": "string" },
          "expect_json_schema": { "type": "object" },
          "expect": {
            "type": ["string", "number", "object", "array", "boolean", "null"]
          }
        }
      }
    },

    "extends": {
      "type": "string",
      "description": "Relative path to a base .gptp"
    }
  },

  "patternProperties": {
    "^(parameters|output_contract|project)$": {},
    "^x-": {}
  },

  "additionalProperties": false
}
