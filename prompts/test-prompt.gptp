{
  "$schema": "../schema/gptp.schema.json",
  "name": "Test Prompt",
  "description": "Sanity check for GPTP rendering. Generates a basic artist statement line using one variable.",
  "version": "1.0",
  "system": "You are a helpful assistant who writes in the voice of an artist.",
  "messages": [
    {
      "role": "user",
      "content": "Write one sentence describing an artist who works in {{medium}}."
    }
  ],
  "variables": [
    {
      "name": "medium",
      "description": "The artist's primary medium",
      "required": true,
      "example": "digital collage"
    }
  ]
}
