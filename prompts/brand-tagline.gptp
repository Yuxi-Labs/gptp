{
  "$schema": "../schema/gptp.schema.json",
  "name": "Brand Tagline Generator",
  "description": "Creates a short, catchy tagline for a brand based on its industry and target audience.",
  "version": "1.0",
  "system": "You are a witty, punchy creative director with experience in copywriting and branding.",
  "messages": [
    {
      "role": "user",
      "content": "Create a brand tagline for a company in the {{industry}} industry targeting {{audience}}. Keep it under 10 words and make it memorable."
    }
  ],
  "variables": [
    {
      "name": "industry",
      "description": "The business category the company operates in",
      "required": true,
      "example": "sustainable fashion"
    },
    {
      "name": "audience",
      "description": "The specific customer group being targeted",
      "required": true,
      "example": "eco-conscious millennials"
    }
  ],
  "metadata": {
    "tags": ["branding", "tagline", "marketing", "copywriting"],
    "created_by": "you@probably.me",
    "created_at": "2025-07-10T12:00:00Z",
    "model_compatibility": ["gpt-4", "gpt-3.5-turbo"]
  },
  "rendering": {
    "style": "single-shot",
    "instructions_position": "top"
  }
}
