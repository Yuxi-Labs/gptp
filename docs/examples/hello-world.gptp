{
  "$doctype": "gptp",
  "schemaVersion": "1.2.0",
  "promptVersion": "1.0.0",
  "title": "Hello World Prompt",
  "description": "Outputs a greeting to the given name.",
  "messages": [
    { "role": "user", "content": "Say hello to {{name}}." }
  ],
  "variables": {
    "name": {
      "type": "string",
      "description": "The person to greet",
      "example": "Alice"
    }
  }
}
