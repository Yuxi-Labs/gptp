{
  "$doctype": "gptp"
  "title": "Hello World Prompt",
  "description": "Outputs a greeting to the given name.",
  "messages": [
    {
      "role": "user",
      "content": "Say hello to {{name}}."
    }
  ],
  "variables": {
    "name": {
      "type": "string",
      "description": "The person to greet",
      "required": true,
      "example": "Alice"
    }
  }
}
